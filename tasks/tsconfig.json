{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "rootDir": "..",
    "types": ["@types/bun", "@types/trusted-types"],
    "paths": {
      "@michijs/michijs": ["../src/index"],
      "@domain": ["../src/domain/index"],
      "@domain/*": ["../src/domain/*"],
      "@shared": ["../src/shared/index"],
      "@shared/*": ["../src/shared/*"],
      "@ports": ["../src/domain/ports/index"],
      "@ports/*": ["../src/domain/ports/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "../src/infrastructure",
    "../src/index.ts",
    "../src/index.node.ts"
  ]
}
