{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json","compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "allowUnusedLabels": true,
    "jsx": "react-jsx",
    "strict": false,
    "jsxImportSource": "@michijs/michijs",
    "paths": {
      "@michijs/michijs/*": ["./src/*"],
      "@michijs/michijs": ["./src/index"],
      "@michijs/michijs/jsx-runtime": [
        "./src/infrastructure/node/jsx-runtime/index"
      ],
      "@michijs/michijs/jsx-dev-runtime": [
        "./src/infrastructure/node/jsx-runtime/index"
      ],
      "@ports": ["./src/domain/ports/index"],
      "@domain": ["./src/domain/index"],
      "@domain/*": ["./src/domain/*"],
      "@shared/*": ["./src/shared/*"],
      "@shared": ["./src/shared/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "dist", "build", "src/infrastructure/plugin", "src/infrastructure/dom", "src/index.ts"]
}
