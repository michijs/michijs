{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@michijs/shared-configs/tsconfig",
  "compilerOptions": {
    "rootDir": "./src",
    "allowUnusedLabels": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@michijs/michijs",
    "types": ["@types/trusted-types"],
    "paths": {
      "@michijs/michijs/jsx-runtime": [
        "./src/infrastructure/dom/jsx-runtime/index"
      ],
      "@michijs/michijs/jsx-dev-runtime": [
        "./src/infrastructure/dom/jsx-runtime/index"
      ],
      "@michijs/michijs/*": ["./src/*"],
      "@michijs/michijs": ["./src/index"]
    }
  },
  "references": [
    {
      "path": "./lib.tsconfig.json"
    },
    {
      "path": "./tests.lib.tsconfig.json"
    },
    {
      "path": "./examples.tsconfig.json"
    }
  ],
  "include": [],
  "exclude": ["node_modules"]
}
